# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit syntax for specific file types
*.ts text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Mark compiled distribution and lock files as generated
dist/** linguist-generated=true
dist/index.js -diff
pnpm-lock.yaml linguist-generated=true
