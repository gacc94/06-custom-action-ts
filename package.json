{
    "name": "custom-action-ts",
    "version": "1.0.0",
    "description": "Enterprise-grade GitHub Action built with Node.js, TypeScript, and pnpm",
    "main": "dist/index.js",
    "engines": {
        "node": ">=22.23.5"
    },
    "packageManager": "pnpm@12.16.1",
    "scripts": {
        "clean": "rimraf dist coverage \"*.tsbuildinfo\"",
        "prepare": "lefthook install",
        "type-check": "tsc -b --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "commitlint": "commitlint --edit",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "build:ncc": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
        "build:esbuild": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --sourcemap",
        "build": "pnpm run clean && pnpm run build:esbuild"
    },
    "dependencies": {
        "@actions/core": "3.0.1",
        "@actions/github": "9.1.1"
    },
    "devDependencies": {
        "@commitlint/cli": "21.2.4",
        "@commitlint/config-conventional": "21.2.4",
        "@commitlint/types": "21.2.3",
        "@eslint/js": "10.0.1",
        "@types/node": "26.6.6",
        "@vercel/ncc": "0.45.0",
        "@vitest/coverage-v8": "5.1.0",
        "@vitest/eslint-plugin": "1.6.28",
        "esbuild": "0.28.2",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-simple-import-sort": "14.0.0",
        "lefthook": "2.2.2",
        "prettier": "3.10.1",
        "rimraf": "6.1.4",
        "typescript": "7.0.2",
        "typescript-eslint": "8.72.2",
        "vitest": "5.1.0"
    }
}
