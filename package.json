{
    "name": "custom-action-ts",
    "version": "1.0.0",
    "description": "Enterprise-grade GitHub Action built with Node.js, TypeScript, and pnpm",
    "main": "dist/index.js",
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "pnpm@12.16.1",
    "scripts": {
        "clean": "rimraf dist \"*.tsbuildinfo\"",
        "type-check": "tsc -b --noEmit",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "test": "vitest run",
        "build:ncc": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
        "build:esbuild": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js --sourcemap",
        "build": "pnpm run clean && pnpm run build:esbuild"
    },
    "dependencies": {
        "@actions/core": "^1.11.1",
        "@actions/github": "^6.0.0"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^22.10.1",
        "@vercel/ncc": "^0.38.3",
        "@vitest/eslint-plugin": "^1.6.28",
        "esbuild": "^0.25.0",
        "eslint": "^10.14.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-simple-import-sort": "^14.0.0",
        "rimraf": "^6.0.1",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.72.2",
        "vitest": "^3.0.5"
    }
}
