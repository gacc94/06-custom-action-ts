{
    "compilerOptions": {
        "target": "ES2024",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2024"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": "./",
        "types": ["node", "vitest/globals"]
    },
    "include": ["src/**/*.test.ts", "vitest.config.mts", "commitlint.config.ts"]
}
