{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": [
            "ES2022"
        ],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": "./",
        "types": [
            "node",
            "vitest/globals"
        ]
    },
    "include": [
        "src/**/*.test.ts",
        "vitest.config.mts"
    ]
}